{
  "servers": {
    "emrf-workspace": {
      "command": "python",
      "args": [
        "${workspaceFolder}/.mcp/emrf_workspace/server.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "MCP_WORKSPACE_ROOT": "${workspaceFolder}",
        "MCP_ALLOW_MUTATIONS": "0"
      }
    },
    "science-data": {
      "command": "python",
      "args": [
        "${workspaceFolder}/.mcp/science_data/server.py"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "MCP_WORKSPACE_ROOT": "${workspaceFolder}",
        "MCP_ALLOW_MUTATIONS": "0"
      }
    }
  }
}
