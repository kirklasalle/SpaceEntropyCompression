\par \pard\plain \s1\ql\keep\widctlpar\sb480\sa0\keepn\ltrpar\cf2\b\dbch\af10\afs28\ab\loch\f5\fs28{\listtext\pard\plain  11.\tab}\ls1 \li1080\ri0\lin1080\rin0\fi-360\keep\sb480\sa0\keepn{\rtlch \ltrch\loch
